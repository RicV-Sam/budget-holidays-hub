# Bing Webmaster URL Submission API.
# Keep this private. Configure locally or as a GitHub Actions secret named BING_WEBMASTER_API_KEY.
BING_WEBMASTER_API_KEY="MY_BING_WEBMASTER_API_KEY"
BING_SITE_URL="https://budgetholidayshub.com"
BING_SITEMAP_URL="https://budgetholidayshub.com/sitemap.xml"
BING_SINCE_DAYS="14"
# Set to 1 only for a deliberate full sitemap resubmission.
BING_SUBMIT_ALL="0"

# IndexNow settings. INDEXNOW_KEY is optional because the public key file is committed at site root.
INDEXNOW_HOST="budgetholidayshub.com"
INDEXNOW_ENDPOINT="https://www.bing.com/indexnow"
INDEXNOW_SITEMAP="sitemap.xml"
INDEXNOW_SINCE_DAYS="14"
